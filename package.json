{
  "name": "image-gallery",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "setup-local-db": "npx wrangler d1 execute analogs-db --local --file=./schema.sql",
    "deploy-db": "npx wrangler d1 execute analogs-db --remote --file=./schema.sql",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/eslint-config": "^2.1.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.2.2",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^10.0.3",
    "hono": "^4.12.7",
    "openapi3-ts": "^4.5.0",
    "pino": "^10.3.1",
    "uuid": "^13.0.0",
    "validator": "^13.15.26",
    "wrangler": "^4.73.0",
    "zod": "^4.3.6"
  },
  "version": "1.0.0",
  "description": "A modern image gallery API built with Cloudflare Workers, Hono framework, R2 blob storage and D1 database.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goncalo2k/image-gallery.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/goncalo2k/image-gallery/issues"
  },
  "homepage": "https://github.com/goncalo2k/image-gallery#readme",
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "husky": "^9.1.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
